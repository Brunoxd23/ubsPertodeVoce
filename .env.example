# ====================================================================
# UBS Perto de Você - Variáveis de Ambiente Globais (.env.example)
# Copie este arquivo para .env antes de executar
# ====================================================================

# Configuração do Servidor Backend
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Segurança de Rede e CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# Banco de Dados PostgreSQL com PostGIS
POSTGRES_DB=ubs_db
POSTGRES_USER=ubs_user
POSTGRES_PASSWORD=ubs_secure_password
DATABASE_URL=postgresql://ubs_user:ubs_secure_password@localhost:5432/ubs_db

# Fallback Standalone para desenvolvimento local sem necessidade de Docker
USE_EMBEDDED_DB=true

# Observabilidade e Proteção LGPD
LOG_LEVEL=info
REDACT_GEOLOCATION_LOGS=true
