# Configuração do Servidor
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Segurança e CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# Banco de Dados PostgreSQL com PostGIS
DATABASE_URL=postgresql://ubs_user:ubs_secure_password@localhost:5432/ubs_db
# Se estiver sem container Docker ativo, o backend utiliza persistência compatível em memória/SQLite para testes e execução local imediata
USE_EMBEDDED_DB=true

# Observabilidade e Log
LOG_LEVEL=info
REDACT_GEOLOCATION_LOGS=true
